# Copy this file to .streamlit/secrets.toml and replace placeholders.
# Never commit or share the real secrets.toml file.

# -----------------------------------------------------------------------------
# Direct text generation providers
# -----------------------------------------------------------------------------
# Supported values:
#   "groq"   -> direct Groq API (primary content provider)
#   "gemini" -> direct Gemini Developer API (optional text fallback)
CALENDAR_GENERATION_PROVIDER = "groq"

# Direct Groq content generation.
GROQ_API_KEY = "gsk_your_key_here"
# GROQ_MODEL = "openai/gpt-oss-120b"
# GROQ_API_URL = "https://api.groq.com/openai/v1/chat/completions"

# -----------------------------------------------------------------------------
# Creative image providers
# -----------------------------------------------------------------------------
# Cloudflare Workers AI is the free-first default. Gemini remains optional and
# Manual Upload remains available in the app regardless of provider settings.
DEFAULT_CREATIVE_PROVIDER = "cloudflare"

# Cloudflare Workers AI / FLUX.1 Schnell.
# In Cloudflare Dashboard -> Workers AI -> Use REST API, copy Account ID and create
# a Workers AI API token. Keep the token server-side only.
CLOUDFLARE_ACCOUNT_ID = "your_cloudflare_account_id_here"
CLOUDFLARE_API_TOKEN = "your_cloudflare_workers_ai_token_here"
CLOUDFLARE_IMAGE_MODEL = "@cf/black-forest-labs/flux-1-schnell"

# Gemini image generation is retained as an optional provider. Some Gemini image
# projects/models require billing or additional project prerequisites.
GEMINI_API_KEY = "your_gemini_developer_api_key_here"
# GEMINI_TEXT_MODEL = "gemini-3.7-flash"
GEMINI_IMAGE_MODEL = "gemini-3.1-flash-lite-image"
# GEMINI_INTERACTIONS_URL = "https://generativelanguage.googleapis.com/v1beta/interactions"

# -----------------------------------------------------------------------------
# Publishing media storage (Supabase Storage)
# -----------------------------------------------------------------------------
# Create a public bucket named publishing-media (or change this setting).
# Keep the service-role key server-side only; never expose it in browser code.
SUPABASE_URL = "https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY = "your_server_side_service_role_key"
SUPABASE_MEDIA_BUCKET = "publishing-media"

# -----------------------------------------------------------------------------
# Meta publishing (Facebook Page + linked Instagram Professional account)
# -----------------------------------------------------------------------------
META_GRAPH_API_VERSION = "v25.0"
# Publication connections store only a credential reference, never the token itself.
# Example: save credential_ref = META_TOKEN_CLIENT_ABC in the app/database, then keep
# the actual token only in runtime secrets/environment:
# META_TOKEN_CLIENT_ABC = "your_page_access_token_here"

# Publish Now works while the app is running. For a single-instance Railway POC,
# enable this lightweight scheduler so due scheduled jobs are checked automatically.
AUTO_PUBLISH_WORKER = false
PUBLISHING_WORKER_INTERVAL_SECONDS = 60

# -----------------------------------------------------------------------------
# Local/deployment persistence
# -----------------------------------------------------------------------------
# Local defaults are used when these are omitted.
# For Railway, mount a persistent volume at /data and use the /data examples.
# CAMPAIGN_DB_PATH = "/data/marketing_poc.sqlite3"
# GENERATED_OUTPUT_DIR = "/data/generated_outputs"
# CREATIVE_OUTPUT_DIR = "/data/generated_outputs/creative_assets"
# BRAND_ASSET_DIR = "/data/generated_outputs/brand_assets"

# Senior review links. Keep localhost for local testing. After deployment, set
# APP_PUBLIC_BASE_URL to the exact public HTTPS URL of this Streamlit app.
APP_PUBLIC_BASE_URL = "http://localhost:8501"
SENIOR_REVIEW_LINK_TTL_HOURS = 72
