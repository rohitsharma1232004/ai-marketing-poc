# Copy this file to .streamlit/secrets.toml and replace placeholders.
# Never commit or share the real secrets.toml file.

# -----------------------------------------------------------------------------
# Direct text generation providers
# -----------------------------------------------------------------------------
# Supported values:
#   "groq"   -> direct Groq API (default)
#   "gemini" -> direct Gemini Developer API
CALENDAR_GENERATION_PROVIDER = "groq"

# Direct Groq.
GROQ_API_KEY = "gsk_your_key_here"
# GROQ_MODEL = "openai/gpt-oss-120b"
# GROQ_API_URL = "https://api.groq.com/openai/v1/chat/completions"

# Gemini text + in-app AI Creative Studio.
# Create/use a Gemini Developer API key; never paste a real key into GitHub.
# GEMINI_API_KEY = "your_gemini_developer_api_key_here"
# GEMINI_TEXT_MODEL = "gemini-3.7-flash"
# GEMINI_IMAGE_MODEL = "gemini-3.1-flash-lite-image"
# GEMINI_INTERACTIONS_URL = "https://generativelanguage.googleapis.com/v1beta/interactions"

# Optional local-development paths.
# CAMPAIGN_DB_PATH = "data/marketing_poc.sqlite3"
# GENERATED_OUTPUT_DIR = "generated_outputs"
# CREATIVE_OUTPUT_DIR = "generated_outputs/creative_assets"
# BRAND_ASSET_DIR = "generated_outputs/brand_assets"

# Senior review links. Keep localhost for local testing. After deployment, set
# APP_PUBLIC_BASE_URL to the exact public HTTPS URL of this Streamlit app.
APP_PUBLIC_BASE_URL = "http://localhost:8501"
SENIOR_REVIEW_LINK_TTL_HOURS = 72
